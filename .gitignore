# ============================================================
# Git exam 工作区 .gitignore
# 只对"尚未被跟踪"的文件生效；已在暂存区/已提交的文件需 git rm --cached
# ============================================================

# --- 依赖与构建产物 ---
node_modules/
dist/
build/
out/
target/
bin/
obj/
*.exe
*.dll
*.o
*.obj
*.class
*.pyc
__pycache__/
venv/
.venv/

# --- 编辑器 / IDE / 系统 ---
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- 环境变量与密钥（切勿提交） ---
.env
.env.*
*.key
*.pem
*.pfx
secrets.json

# --- 日志与临时文件 ---
*.log
*.tmp
*.bak
*.orig
*.rej

# --- 打包产物 ---
*.zip
*.7z
*.rar

# ============================================================
# 注意：如果考试要求提交 .docx / .pdf / 图片等二进制素材，
# 不要把上面的扩展名加进来——本机 Git LFS 是全局强制开启的，
# 一旦用 *.docx 之类的规则触发 LFS，需要先在本仓库执行
#   git lfs install --local
# 否则可能出现提交/推送失败。
# ============================================================
